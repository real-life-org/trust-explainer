{
  "name": "encounter-animation",
  "version": "0.1.0",
  "private": true,
  "description": "Remotion experiment: the in-person encounter of the Real Life Trust Protocol",
  "scripts": {
    "studio": "remotion studio src/index.ts",
    "render": "remotion render src/index.ts Encounter out/encounter.mp4",
    "render:square": "remotion render src/index.ts EncounterSquare out/encounter-square.mp4",
    "stills": "node scripts/stills.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@remotion/cli": "4.0.536",
    "qrcode-generator": "2.0.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "remotion": "4.0.536"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "typescript": "5.9.3"
  }
}
