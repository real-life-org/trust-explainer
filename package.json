{
  "name": "trust-explainer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Explainer for the Real Life Trust Protocol: chapters rendered as deck, video and web graphics",
  "license": "MIT",
  "repository": "github:real-life-org/trust-explainer",
  "scripts": {
    "dev": "vite --config web/vite.config.ts",
    "build": "vite build --config web/vite.config.ts",
    "render": "node scripts/render.mjs --chapter no-issuer --out out/no-issuer.mp4",
    "render:square": "node scripts/render.mjs --chapter no-issuer --format square --out out/no-issuer-square.mp4",
    "stills": "node scripts/stills.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "qrcode-generator": "2.0.4",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "playwright-core": "1.63.0",
    "typescript": "5.9.3",
    "vite": "8.3.1"
  }
}
